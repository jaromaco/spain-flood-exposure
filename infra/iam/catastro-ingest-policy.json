{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteBronzeCatastro",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::jaromaco-flood-datalake/bronze/catastro/*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-west-1:925817253831:log-group:/aws/lambda/catastro-ingest*"
    }
  ]
}
